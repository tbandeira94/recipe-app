{
  "manifest_version": 3,
  "name": "Pantry Book Pinterest URL Collector",
  "version": "0.1.0",
  "description": "Collect outbound URLs from a Pinterest board without importing recipes.",
  "permissions": ["activeTab", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": ["https://www.pinterest.com/*"],
  "action": {
    "default_title": "Pinterest URL Collector",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
